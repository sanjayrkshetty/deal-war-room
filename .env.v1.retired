# Presales Intelligence Environment Configuration
# API Keys (Optional; system gracefully falls back to local models/embeddings if absent)

# Google Gemini API Key (used for Google Antigravity SDK agents & subagent delegation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (used for fast scrubbed LLM inference & RAG drafting)
GROQ_API_KEY=your_groq_api_key_here

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Path Configuration
DATABASE_PATH=corpus/scrubbed/presales_intelligence.db
